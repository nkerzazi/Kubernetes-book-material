# Etape 7 — image finale : sans gestionnaire de paquets, en utilisateur non
# privilegie. On y perd le diagnostic depuis l'interieur du conteneur : c'est
# un arbitrage assume, pas une optimisation gratuite (cf. section 2.9.4).
FROM python:3.12-slim AS build
WORKDIR /src
COPY requirements.txt .
RUN pip install --no-cache-dir --target=/deps -r requirements.txt

FROM gcr.io/distroless/python3-debian12:nonroot
WORKDIR /app
ENV PYTHONPATH=/deps:/app PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY --from=build /deps /deps
COPY escale_api ./escale_api
COPY escale_common ./escale_common
USER nonroot
EXPOSE 8000
CMD ["-m", "uvicorn", "escale_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
