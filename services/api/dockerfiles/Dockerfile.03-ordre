# Etape 3 — dependances copiees avant le code.
# Agit sur le TEMPS de reconstruction, pas sur la taille : effet inverse de l'etape 2.
FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install -r requirements.txt
COPY . .
EXPOSE 8000
CMD ["uvicorn", "escale_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
