# Etape 4 — identique, mais le .dockerignore de la racine est en place.
# Le gain porte sur le contexte transfere et stabilise le cache.
FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install -r requirements.txt
COPY . .
EXPOSE 8000
CMD ["uvicorn", "escale_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
